      "title": "Sum a short sequence",
      "concept_ids": [
        "sequence_iteration"
      ],
      "inventory": "practice",
      "modality": "code",
      "evidence_mode": "implement",
      "statement": "Return the integer sum of every element in the supplied sequence. An empty sequence has sum zero.",
      "rubric": "The reference result is the integer sum; runtime execution is deferred to M6.",
      "difficulty": 1,
      "calibration": "uncalibrated",
      "estimated_minutes": 10,
      "family_id": "sum_practice",
      "variants": [
        {
          "language": "python",
          "adapter_version": "1.0.0",
          "starter_code": "def solve(values):\n    pass",
          "reference_solution": "def solve(values):\n    return sum(values)",
          "interface": "Return the sum of a sequence of integers; fixture only.",
          "runtime_ref": "fixture/python@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "time_limit_ms": 1000,
          "memory_limit_mb": 128
        },
        {
          "language": "cpp",
          "adapter_version": "1.0.0",
          "starter_code": "long long solve(const std::vector<int>& values);",
          "reference_solution": "long long solve(const std::vector<int>& values) { long long total = 0; for (int value : values) total += value; return total; }",
          "interface": "Return the sum of a sequence of integers; fixture only.",
          "runtime_ref": "fixture/cpp@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "time_limit_ms": 1000,
          "memory_limit_mb": 128
        },
        {
          "language": "java",
          "adapter_version": "1.0.0",
          "starter_code": "static long solve(int[] values) { throw new UnsupportedOperationException(); }",
          "reference_solution": "static long solve(int[] values) { long total = 0; for (int value : values) total += value; return total; }",
          "interface": "Return the sum of a sequence of integers; fixture only.",
          "runtime_ref": "fixture/java@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "time_limit_ms": 1000,
          "memory_limit_mb": 128
