          "maximum": 3,
          "minimum": 0,
          "title": "Help Ceiling",
          "type": "integer"
        },
        "maximum_daily_minutes": {
          "maximum": 180,
          "minimum": 1,
          "title": "Maximum Daily Minutes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "goals",
        "concept_ids",
        "help_ceiling",
        "maximum_daily_minutes"
      ],
      "title": "TrackPolicy",
      "type": "object"
