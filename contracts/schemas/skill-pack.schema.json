    "LanguageVariant": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            "python",
            "cpp",
            "java"
          ],
          "title": "Language",
          "type": "string"
        },
        "adapter_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Adapter Version",
          "type": "string"
        },
        "starter_code": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Starter Code",
          "type": "string"
        },
        "reference_solution": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Reference Solution",
          "type": "string"
        },
        "interface": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Interface",
          "type": "string"
        },
        "runtime_ref": {
          "pattern": "^[a-z0-9./:_-]+@sha256:[a-f0-9]{64}$",
          "title": "Runtime Ref",
          "type": "string"
        },
        "time_limit_ms": {
          "maximum": 30000,
          "minimum": 10,
          "title": "Time Limit Ms",
          "type": "integer"
        },
        "memory_limit_mb": {
          "maximum": 1024,
          "minimum": 16,
          "title": "Memory Limit Mb",
          "type": "integer"
        }
      },
      "required": [
        "language",
        "starter_code",
        "reference_solution",
        "interface",
        "runtime_ref",
        "time_limit_ms",
        "memory_limit_mb"
      ],
      "title": "LanguageVariant",
      "type": "object"
    },
    "MasteryPolicy": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "const": "independent_unseen_and_delayed",
          "default": "independent_unseen_and_delayed",
          "title": "Rule",
          "type": "string"
        },
        "minimum_independent": {
          "maximum": 100,
          "minimum": 2,
          "title": "Minimum Independent",
          "type": "integer"
        },
        "minimum_families": {
          "maximum": 100,
          "minimum": 2,
          "title": "Minimum Families",
          "type": "integer"
        },
        "retention_days": {
          "maximum": 365,
          "minimum": 1,
          "title": "Retention Days",
          "type": "integer"
        },
        "passive_weight": {
          "const": 0,
          "default": 0,
          "title": "Passive Weight",
          "type": "integer"
        }
      },
      "required": [
        "minimum_independent",
        "minimum_families",
        "retention_days"
      ],
      "title": "MasteryPolicy",
      "type": "object"
    },
    "Migration": {
      "additionalProperties": false,
      "properties": {
        "from_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "From Version",
          "type": "string"
        },
        "concept_mapping": {
          "maxProperties": 1000,
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            }
          },
          "title": "Concept Mapping",
          "type": "object"
        },
        "rationale": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "from_version",
        "concept_mapping",
        "rationale"
      ],
      "title": "Migration",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
