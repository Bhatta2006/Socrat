{
  "$defs": {
    "Blueprint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "diagnostic",
            "baseline",
            "weekly",
            "final"
          ],
          "title": "Kind",
          "type": "string"
        },
        "exercise_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Exercise Ids",
          "type": "array"
        },
        "concept_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "scoring": {
          "enum": [
            "deterministic",
            "human_rubric"
          ],
          "title": "Scoring",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "exercise_ids",
        "concept_ids",
        "scoring"
      ],
      "title": "Blueprint",
      "type": "object"
    },
    "Concept": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "competency": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Competency",
          "type": "string"
        },
        "explanation": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "examples": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Examples",
          "type": "array"
        },
        "misconceptions": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Misconceptions",
          "type": "array"
        },
        "evidence_modes": {
          "items": {
            "enum": [
              "recognize",
              "trace",
              "explain",
              "implement",
              "analyze",
              "transfer",
              "retain"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Evidence Modes",
          "type": "array"
        },
        "estimated_minutes": {
          "maximum": 600,
          "minimum": 1,
          "title": "Estimated Minutes",
          "type": "integer"
        },
        "accessibility": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Accessibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "competency",
        "explanation",
        "examples",
        "misconceptions",
        "evidence_modes",
        "estimated_minutes",
        "accessibility"
      ],
      "title": "Concept",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "prerequisite": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Prerequisite",
          "type": "string"
        },
        "concept": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Concept",
          "type": "string"
        },
        "minimum_mastery": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mastery",
          "type": "number"
        },
        "rationale": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "prerequisite",
        "concept",
        "minimum_mastery",
        "rationale"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Exercise": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "concept_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "inventory": {
          "enum": [
            "practice",
            "assessment"
          ],
          "title": "Inventory",
          "type": "string"
        },
        "modality": {
          "enum": [
            "text",
            "code"
          ],
          "title": "Modality",
          "type": "string"
        },
        "evidence_mode": {
          "enum": [
            "recognize",
            "trace",
            "explain",
            "implement",
            "analyze",
            "transfer",
            "retain"
          ],
          "title": "Evidence Mode",
          "type": "string"
        },
        "statement": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "rubric": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Rubric",
          "type": "string"
        },
        "difficulty": {
          "maximum": 10,
          "minimum": 1,
          "title": "Difficulty",
          "type": "integer"
        },
        "calibration": {
          "default": "uncalibrated",
          "enum": [
            "uncalibrated",
            "reviewed"
          ],
          "title": "Calibration",
          "type": "string"
        },
        "estimated_minutes": {
          "maximum": 180,
          "minimum": 1,
          "title": "Estimated Minutes",
          "type": "integer"
        },
        "family_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Family Id",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/LanguageVariant"
          },
          "maxItems": 3,
          "title": "Variants",
          "type": "array"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/TestCase"
          },
          "maxItems": 1000,
          "title": "Tests",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "accessibility": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Accessibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "concept_ids",
        "inventory",
        "modality",
        "evidence_mode",
        "statement",
        "rubric",
        "difficulty",
        "estimated_minutes",
        "family_id",
        "provenance",
        "accessibility"
      ],
