      "type": "object"
    },
    "GoalTemplate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "outcome": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "track_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Track Id",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "enum": [
              "target_date",
              "days_per_week",
              "minutes_per_session",
              "timezone",
              "language"
