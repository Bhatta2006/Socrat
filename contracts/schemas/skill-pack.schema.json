  "required": [
    "key",
    "version",
    "domain",
    "title",
    "purpose",
    "change_log",
    "modalities",
    "languages",
    "provenance",
    "concepts",
    "edges",
    "goals",
    "tracks",
    "exercises",
    "blueprints",
