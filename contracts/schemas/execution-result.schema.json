{
  "$defs": {
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "maximum": 99,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "status": {
          "enum": [
            "passed",
            "wrong_answer",
            "executed",
            "compile_error",
            "runtime_error",
            "timeout",
            "memory_limit",
            "output_limit"
          ],
          "title": "Status",
          "type": "string"
        },
        "wall_ms": {
          "maximum": 60000,
          "minimum": 0,
          "title": "Wall Ms",
          "type": "integer"
        },
        "stdout": {
          "default": "",
          "maxLength": 16000,
          "title": "Stdout",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "maxLength": 16000,
          "title": "Stderr",
          "type": "string"
        }
      },
      "required": [
        "index",
        "status",
        "wall_ms"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "nonce": {
          "title": "Nonce",
          "type": "string"
        },
        "code_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Code Hash",
          "type": "string"
        },
        "test_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Test Digest",
          "type": "string"
        },
        "image": {
          "pattern": "^[a-z0-9./:_-]+@sha256:[a-f0-9]{64}$",
          "title": "Image",
          "type": "string"
        },
        "operational_status": {
          "enum": [
            "healthy",
            "failed"
          ],
          "title": "Operational Status",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/CaseResult"
          },
          "maxItems": 100,
          "title": "Cases",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "execution_finalized",
            "sandbox_unavailable",
            "worker_failure",
            "lease_expired",
            "content_withdrawn"
          ],
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "nonce",
        "code_hash",
        "test_digest",
        "image",
        "operational_status",
        "cases",
        "reason_code"
      ],
      "title": "ExecutionResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/ExecutionResult"
    },
    "signature": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "result",
    "signature"
  ],
  "title": "ResultEnvelope",
  "type": "object"
}
