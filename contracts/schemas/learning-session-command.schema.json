{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "advance",
        "pause",
        "resume",
        "abandon",
        "start_timed",
        "upsolve"
      ],
      "title": "Action",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "pattern": "^[a-zA-Z0-9_-]{1,64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "answer": {
      "anyOf": [
        {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer"
    },
    "run_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9-]{36}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "error_classification": {
      "anyOf": [
        {
          "enum": [
            "wrong_answer",
            "implementation_bug",
            "complexity",
            "time_pressure",
            "concept_gap",
            "unclear_prompt"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Classification"
    },
    "reflection": {
      "anyOf": [
        {
          "enum": [
            "concept_gap",
            "pattern_recognition",
            "implementation_bug",
            "complexity",
            "unclear_prompt",
            "time_pressure",
            "none"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reflection"
    }
  },
  "required": [
    "action",
    "expected_revision",
    "idempotency_key"
  ],
  "title": "SessionAction",
  "type": "object"
}
