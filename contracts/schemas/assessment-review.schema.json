{
  "additionalProperties": false,
  "properties": {
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "pattern": "^[a-zA-Z0-9_-]{1,64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "decision": {
      "enum": [
        "accept",
        "exclude"
      ],
      "title": "Decision",
      "type": "string"
    },
    "criterion_scores": {
      "maxProperties": 12,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,63}$": {
          "type": "integer"
        }
      },
      "title": "Criterion Scores",
      "type": "object"
    },
    "evidence_reference": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Evidence Reference",
      "type": "string"
    },
    "rationale": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "revision",
    "idempotency_key",
    "decision",
    "evidence_reference",
    "rationale"
  ],
  "title": "ReviewInput",
  "type": "object"
}
