{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "cpu_seconds": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Cpu Seconds",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 5,
          "maximum": 15,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "memory_mb": {
          "default": 256,
          "maximum": 1024,
          "minimum": 64,
          "title": "Memory Mb",
          "type": "integer"
        },
        "pids": {
          "default": 64,
          "maximum": 128,
          "minimum": 8,
          "title": "Pids",
          "type": "integer"
        },
        "output_bytes": {
          "default": 10000000,
          "maximum": 10000000,
          "minimum": 1024,
          "title": "Output Bytes",
          "type": "integer"
        },
        "disk_mb": {
          "default": 10,
          "maximum": 32,
          "minimum": 1,
          "title": "Disk Mb",
          "type": "integer"
        },
        "compile_seconds": {
          "default": 15,
          "maximum": 30,
          "minimum": 1,
          "title": "Compile Seconds",
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9_-]{1,64}$",
      "title": "Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "python",
        "cpp",
        "java"
      ],
      "title": "Language",
      "type": "string"
    },
    "image": {
      "pattern": "^[a-z0-9./:_-]+@sha256:[a-f0-9]{64}$",
      "title": "Image",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "attestation_reference": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Attestation Reference",
      "type": "string"
    }
  },
  "required": [
    "id",
    "language",
    "image",
    "limits",
    "attestation_reference"
  ],
  "title": "RuntimeProfile",
  "type": "object"
}
