{
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "pattern": "^[a-zA-Z0-9_-]{1,64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "draft_revision": {
      "minimum": 0,
      "title": "Draft Revision",
      "type": "integer"
    },
    "reasoning": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reasoning",
      "type": "string"
    },
    "requested_level": {
      "default": 1,
      "maximum": 5,
      "minimum": 1,
      "title": "Requested Level",
      "type": "integer"
    },
    "action": {
      "default": "hint",
      "enum": [
        "hint",
        "accessibility",
        "exit"
      ],
      "title": "Action",
      "type": "string"
    }
  },
  "required": [
    "idempotency_key",
    "draft_revision",
    "reasoning"
  ],
  "title": "HintRequest",
  "type": "object"
}
