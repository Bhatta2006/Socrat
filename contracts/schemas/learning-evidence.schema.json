{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "maxLength": 36,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "user_id": {
      "maxLength": 36,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "goal_id": {
      "maxLength": 36,
      "minLength": 1,
      "title": "Goal Id",
      "type": "string"
    },
    "track": {
      "enum": [
        "foundations",
        "interview",
        "competitive"
      ],
      "title": "Track",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "kind": {
      "default": "scored",
      "enum": [
        "scored",
        "invalidated"
      ],
      "title": "Kind",
      "type": "string"
    },
    "target_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Event Id"
    },
    "source_id": {
      "maxLength": 36,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "pack_id": {
      "maxLength": 36,
      "minLength": 1,
      "title": "Pack Id",
      "type": "string"
    },
    "pack_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Pack Digest",
      "type": "string"
    },
    "language": {
      "maxLength": 16,
      "title": "Language",
      "type": "string"
    },
    "concept_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Concept Ids",
      "type": "array"
    },
    "mode": {
      "enum": [
        "diagnostic",
        "practice",
        "assessment",
        "retention",
        "passive"
      ],
      "title": "Mode",
      "type": "string"
    },
    "evidence_type": {
      "enum": [
        "recognize",
        "trace",
        "analyze",
        "explain",
        "implement",
        "transfer",
        "retain"
      ],
      "title": "Evidence Type",
      "type": "string"
    },
    "family_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Family Id",
      "type": "string"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "quality": {
      "maximum": 1,
      "minimum": 0,
      "title": "Quality",
      "type": "number"
    },
    "hint_level": {
      "maximum": 5,
      "minimum": 0,
      "title": "Hint Level",
      "type": "integer"
    },
    "elapsed_seconds": {
      "default": 0.0,
      "maximum": 2700,
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "expected_seconds": {
      "default": 60.0,
      "exclusiveMinimum": 0,
      "maximum": 10800,
      "title": "Expected Seconds",
      "type": "number"
    },
    "difficulty": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Difficulty",
      "type": "integer"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "unseen": {
      "title": "Unseen",
      "type": "boolean"
    },
    "finalized": {
      "title": "Finalized",
      "type": "boolean"
    },
    "occurred_at": {
      "minimum": 0,
      "title": "Occurred At",
      "type": "integer"
    },
    "scoring_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Scoring Version",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "reason_code": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Reason Code",
      "type": "string"
    },
    "review_group_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Group Id"
    },
    "misconception_codes": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "maxItems": 30,
      "title": "Misconception Codes",
      "type": "array"
    }
  },
  "required": [
    "event_id",
    "user_id",
    "goal_id",
    "track",
    "sequence",
    "source_id",
    "pack_id",
    "pack_digest",
    "language",
    "concept_ids",
    "mode",
    "evidence_type",
    "family_id",
    "score",
    "quality",
    "hint_level",
    "valid",
    "unseen",
    "finalized",
    "occurred_at",
    "scoring_version",
    "policy_version",
    "policy_digest",
    "reason_code"
  ],
  "title": "EvidenceFact",
  "type": "object"
}
