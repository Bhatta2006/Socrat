{
  "name": "socrat",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "overrides": {
    "dompurify": "3.4.16"
  },
  "scripts": {
    "dev:demo": "node scripts/dev/run-demo.mjs",
    "dev": "npm run dev --workspace @socrat/web",
    "build": "npm run build --workspace @socrat/web",
    "typecheck": "npm run typecheck --workspace @socrat/web",
    "test:m0": "node --test prototypes/concierge/model.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0"
  }
}
