{
  "name": "socrat", "private": true,
  "workspaces": ["apps/web"],
  "engines": {"node": ">=22.0.0 <25"},
  "overrides": {"dompurify": "3.4.16"},
  "scripts": {
    "dev:demo": "node scripts/dev/run-demo.mjs",
    "demo": "node scripts/demo/start.mjs",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "dev": "npm run dev --workspace @socrat/web",
    "build": "npm run build --workspace @socrat/web",
    "typecheck": "npm run typecheck --workspace @socrat/web",
    "test:m0": "node --test prototypes/concierge/model.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {"@playwright/test": "^1.55.0"}
}
